[Unit]
Description=Tim telemetry SQLite backup
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/cst-pilot-server/backup.py --database /srv/cst-pilot-server/data/telemetry.db --output-dir /srv/cst-pilot-server/backups
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/cst-pilot-server/backups
